{
  "name": "@kanseishitsu/agent",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:mac && bun run build:win",
    "build:mac": "../../node_modules/.bin/bun build src/main.ts --compile --minify --target=bun-darwin-arm64 --outfile bin/kanseishitsu-agent-macos-arm64",
    "build:win": "../../node_modules/.bin/bun build src/main.ts --compile --minify --target=bun-windows-x64 --outfile bin/kanseishitsu-agent-windows-x64.exe"
  },
  "dependencies": {
    "@kanseishitsu/shared": "workspace:*"
  },
  "//": "Bun 1.3.13 の --compile 出力は macOS 27 で署名が壊れて起動できないため、ビルドにはリポジトリ内の Bun 1.4.2 を使う"
}
