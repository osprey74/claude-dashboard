<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- install.sh がプレースホルダーを実際の値に置き換えて ~/Library/LaunchAgents に配置する -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.osprey74.kanseishitsu</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BUN__</string>
    <string>__REPO__/apps/server/src/index.ts</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__BUN_DIR__:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>NODE_ENV</key>
    <string>production</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/kanseishitsu/server.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/kanseishitsu/server.err.log</string>
</dict>
</plist>
